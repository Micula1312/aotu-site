---
// src/pages/controller.astro
import "../styles/controller.css";
import "../styles/aotu-header.css";

const RAW_WP_API_URL = (
  import.meta.env.PUBLIC_WP_API_URL ||
  "https://thearchiveoftheuntamed.xyz/wp"
).replace(/\/$/, "");

const WP_API_URL = RAW_WP_API_URL.endsWith("/wp-json")
  ? RAW_WP_API_URL
  : `${RAW_WP_API_URL}/wp-json`;

const STATE_API_URL = `${WP_API_URL}/aotu/v1/state`;
const TAGS_API_URL = `${WP_API_URL}/wp/v2/tags?per_page=100`;
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>THE ARCHIVE IS ALIVE</title>

    <script is:inline define:vars={{ STATE_API_URL, TAGS_API_URL }}>
      window.__AOTU_STATE_API_URL = STATE_API_URL;
      window.__AOTU_TAGS_API_URL = TAGS_API_URL;
    </script>
  </head>

  <body class="aotu-controller-page">
    <main class="controller-shell">
      <header class="aotu-page-header">
        <p class="aotu-eyebrow">THE ARCHIVE OF THE UNTAMED</p>

        <p class="aotu-work-number">■ 5. THE ARCHIVE IS ALIVE, 2026</p>

        <h1 class="aotu-page-title">Installazione multimediale immersiva</h1>

        <p class="controller-subtitle">Archive Interface</p>

        <div class="connection" id="connectionState">polling</div>
      </header>

      <section class="panel panel-targets">
        <h2>Target</h2>
        <div class="target-grid" id="targetGrid">
          <button class="target is-active" data-target="all">ALL</button>
          <button class="target" data-target="screen-1">1</button>
          <button class="target" data-target="screen-2">2</button>
          <button class="target" data-target="screen-3">3</button>
          <button class="target" data-target="screen-4">4</button>
          <button class="target" data-target="screen-5">5</button>
          <button class="target" data-target="screen-6">6</button>
        </div>
      </section>

      <section class="panel panel-actions">
        <h2>Actions</h2>
        <div class="action-grid">
          <button class="action" id="cmdRandom">RANDOM ARCHIVE</button>
          <button class="action" id="cmdBlackout">BLACKOUT</button>
          <button class="action" id="cmdWake">WAKE</button>
          <button class="action" id="cmdReset">RESET</button>
        </div>
      </section>

      <section class="panel panel-tags">
        <div class="panel-title-row">
          <h2>Database Tags</h2>
          <button class="mini" id="reloadTags">reload</button>
        </div>

        <input
          class="search"
          id="tagSearch"
          type="search"
          placeholder="cerca hashtag…"
          autocomplete="off"
        />

        <div class="tag-cloud" id="tagCloud">
          <span class="muted">loading tags…</span>
        </div>
      </section>

      <section class="panel panel-log">
        <h2>Live Log</h2>
        <pre id="logBox">ready</pre>
      </section>

      <section class="panel panel-ending">
        <p>Sei in controllo.</p>
        <p>Apparentemente.</p>
        <p>Puoi respirare. Esplora l'archivio.</p>
        <p>
          Ma se arrivata fin qui ti senti un po' meglio, e decidi di riporre
          ancora un po' di fiducia nell'arte, negli altri, o semplicemente nello
          spazio che stai attraversando, torna all'ingresso.
        </p>
        <p>Lascia il telefono sulla parete. E attraversa ancora.</p>

        <a class="offline-link" href="/offline">
          ■ 2. #WEPLAYOFFLINE, 2026<br />
          <span>GO TO</span>
        </a>
      </section>
    </main>

    <script>
      import "../scripts/controller/controller.js";
    </script>

    <style>
      .aotu-work-number {
        margin: 0;
        font-family: inherit;
        font-size: clamp(1.2rem, 5vw, 2.3rem);
        line-height: 0.95;
        letter-spacing: -0.04em;
        text-transform: uppercase;
      }

      .controller-subtitle {
        margin: 0;
        opacity: 0.66;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.78rem;
      }

      .panel-ending {
        display: grid;
        gap: 1rem;
      }

      .panel-ending p {
        margin: 0;
        line-height: 1.28;
      }

      .offline-link {
        display: block;
        margin-top: 1rem;
        border: 1px solid currentColor;
        padding: 1rem;
        color: inherit;
        text-decoration: none;
        text-transform: uppercase;
      }

      .offline-link span {
        opacity: 0.64;
        font-size: 0.78rem;
        letter-spacing: 0.12em;
      }
    </style>
  </body>
</html>
